APP_NAME="AI Real-World English Simulator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost:8002
APP_PORT=8002

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
# DB_HOST=db
# DB_PORT=3306
# FORWARD_DB_PORT=3309
# DB_USERNAME=simulator_user
# DB_PASSWORD=simulator_password
# DB_ROOT_PASSWORD=root_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=ai-english-simulator-audio
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AI Service Configuration (openrouter | gemini)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Gemini AI Service Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Simulator Scoring & Timing Parameters
SIMULATOR_CSI_WEIGHT_RESOLUTION=0.40
SIMULATOR_CSI_WEIGHT_ADAPTABILITY=0.35
SIMULATOR_CSI_WEIGHT_FLOW=0.25
SIMULATOR_WORD_SCORE_GREEN=85
SIMULATOR_WORD_SCORE_ORANGE=60
SIMULATOR_REDO_MAX_ATTEMPTS=2
SIMULATOR_REDO_COOLDOWN_SECONDS=1.5
SIMULATOR_THINKING_DURATION_SECONDS=15
SIMULATOR_THINKING_HINT_REMINDER_SECONDS=8

VITE_APP_NAME="${APP_NAME}"
